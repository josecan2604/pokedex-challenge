{
  "info": {
    "name": "Pokedex Challenge",
    "_postman_id": "6d1f3a3e-8a7b-4c39-9f6e-2b1c5d7e9a01",
    "description": "End-to-end requests for the Pokedex backend. Every call goes through the API gateway ({{baseUrl}}).\n\nRun the whole collection in order (Collection Runner or `npx newman run`): the Auth folder stores `userToken` and `adminToken`, and later requests reuse them.\n\nDemo users: `ash / Pikachu123` (USER), `admin / Admin1234` (ADMIN).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "syncedVersion",
      "value": "0"
    }
  ],
  "item": [
    {
      "name": "1. OAuth2 discovery",
      "item": [
        {
          "name": "JWKS (public signing keys)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const key = pm.response.json().keys[0];",
                  "pm.test('RSA public key, RS256', () => { pm.expect(key.kty).to.eql('RSA'); pm.expect(key.alg).to.eql('RS256'); });",
                  "pm.test('private parts never published', () => { pm.expect(key).to.not.have.property('d'); pm.expect(key).to.not.have.property('p'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/oauth2/jwks"
          }
        },
        {
          "name": "Authorization server metadata",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('advertises token endpoint and JWKS', () => { const m = pm.response.json(); pm.expect(m.token_endpoint).to.include('/oauth2/token'); pm.expect(m.jwks_uri).to.include('/oauth2/jwks'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/.well-known/oauth-authorization-server"
          }
        }
      ]
    },
    {
      "name": "2. Auth",
      "item": [
        {
          "name": "Register a new user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('newUsername', 'trainer_' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('role is USER and no password hash leaks', () => { const u = pm.response.json(); pm.expect(u.role).to.eql('USER'); pm.expect(u).to.not.have.property('passwordHash'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{newUsername}}\",\n  \"email\": \"{{newUsername}}@pokedex.local\",\n  \"password\": \"Trainer123\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Register - invalid input (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 with one error per field', () => { pm.response.to.have.status(400); const e = pm.response.json().errors; pm.expect(e).to.have.keys('username', 'email', 'password'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"x\",\n  \"email\": \"not-an-email\",\n  \"password\": \"1\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Register - duplicate username (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ash\",\n  \"email\": \"someone-else@pokedex.local\",\n  \"password\": \"Pikachu123\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Token - USER (ash)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Bearer token, not cacheable', () => { pm.expect(body.token_type).to.eql('Bearer'); pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'); });",
                  "pm.collectionVariables.set('userToken', body.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "username",
                  "value": "ash"
                },
                {
                  "key": "password",
                  "value": "Pikachu123"
                }
              ]
            },
            "url": "{{baseUrl}}/oauth2/token"
          }
        },
        {
          "name": "Token - ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "username",
                  "value": "admin"
                },
                {
                  "key": "password",
                  "value": "Admin1234"
                }
              ]
            },
            "url": "{{baseUrl}}/oauth2/token"
          }
        },
        {
          "name": "Token - wrong password (400 invalid_grant)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('RFC 6749 invalid_grant', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().error).to.eql('invalid_grant'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "username",
                  "value": "ash"
                },
                {
                  "key": "password",
                  "value": "wrong-password"
                }
              ]
            },
            "url": "{{baseUrl}}/oauth2/token"
          }
        },
        {
          "name": "Token - unsupported grant type (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('RFC 6749 unsupported_grant_type', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().error).to.eql('unsupported_grant_type'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            },
            "url": "{{baseUrl}}/oauth2/token"
          }
        }
      ]
    },
    {
      "name": "3. Pokemon catalog (US01, US02) - public",
      "item": [
        {
          "name": "US01 - Browse, page 0",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test('page envelope', () => { pm.expect(page).to.include.keys('content', 'page', 'size', 'totalElements', 'totalPages'); pm.expect(page.content).to.have.lengthOf(12); });",
                  "pm.test('each entry has sprite, category, weight and abilities', () => page.content.forEach(p => { pm.expect(p.spriteUrl).to.be.a('string'); pm.expect(p.category).to.be.a('string'); pm.expect(p.weightKg).to.be.a('number'); pm.expect(p.abilities).to.be.an('array').that.is.not.empty; }));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/pokemon?page=0&size=12",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pokemon"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "12"
                }
              ]
            }
          }
        },
